{
  "name": "shelterprep",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:processing": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/phase1-processing-server.mjs",
    "build": "tsc && vite build",
    "test": "node --test scripts/*.test.mjs",
    "benchmark:inspection": "node scripts/inspection-report-benchmark.mjs run --all",
    "benchmark:inspection:init": "node scripts/inspection-report-benchmark.mjs init-case",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
